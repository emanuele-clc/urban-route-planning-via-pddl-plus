    (= (speed-limit loc000 loc001) 13.8889)
    (road loc000 loc004)
    (= (road-length loc000 loc004) 200.0)
    (= (speed-limit loc000 loc004) 13.8889)
    (road loc001 loc000)
    (= (road-length loc001 loc000) 180.0)
    (= (speed-limit loc001 loc000) 13.8889)
    (road loc001 loc002)
    (= (road-length loc001 loc002) 220.0)
    (= (speed-limit loc001 loc002) 8.3333)
    (road loc001 loc005)
    (= (road-length loc001 loc005) 100.0)
    (= (speed-limit loc001 loc005) 8.3333)
    (road loc002 loc001)
    (= (road-length loc002 loc001) 220.0)
    (= (speed-limit loc002 loc001) 8.3333)
    (road loc002 loc003)
    (= (road-length loc002 loc003) 150.0)
    (= (speed-limit loc002 loc003) 13.8889)
    (road loc003 loc002)
    (= (road-length loc003 loc002) 150.0)
    (= (speed-limit loc003 loc002) 13.8889)
