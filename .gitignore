# File di configurazione SUMO: contengono percorsi ASSOLUTI della macchina
# che li ha generati, quindi non hanno senso condivisi. Vengono ricreati
# automaticamente da sumo_visualize.py a ogni avvio.
cfg_files/*.sumocfg
cfg_files/gui_*.xml
cfg_files/*_piano.rou.xml
cfg_files/*_piano.rou.alt.xml
cfg_files/*_trip.xml
cfg_files/sumo_errors.txt

# Artefatti generati a runtime/da script diagnostici: non servono al
# funzionamento della pipeline (a differenza di sumo_extracted/*.json,
# che sono input letti da build_problems.py/webapp/inject_signal_plan.py)
# e venivano ricommittati a ogni uso della webapp o rerun degli script.
pddl_files/problem_custom.pddl
pddl_files/route_custom.json
pddl_files/output_*.txt
comparison_results/
diagnostics_out/
sumo_comparison/results.json

# Video generati da /api/sumo_video (webapp/app.py) via --video-out di
# sumo_visualize.py: sovrascritti a ogni richiesta, non servono al repo.
webapp/static/videos/

possibili_ottimizzazioni.md
