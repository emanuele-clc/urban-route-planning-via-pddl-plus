<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="cosenza_live.net.xml"/>
        <route-files value="route_live.rou.xml"/>
        <gui-settings-file value="gui_settings.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="7200"/>
        <step-length value="0.5"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
    </processing>
    <report>
        <no-warnings value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
